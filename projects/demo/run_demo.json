{
  "_comment": "Demo project config - OpenNeuro ds004937 (4 subjects, 4 sessions)",
  "_updated": "2026-02-13",
  "_usage": "Run with: ./cat12_prepro --config projects/demo/run_demo.json",
  "study": {
    "name": "OpenNeuro ds004937 Demo",
    "description": "Longitudinal preprocessing with CAT12 using OpenNeuro ds004937",
    "project_folder": "/data/local/software/cat-12/projects/demo"
  },
  "software": {
    "mode": "standalone",
    "_mode_comment": "standalone (with MCR) or matlab (requires license)",
    "matlab": {
      "executable": "matlab",
      "allow_graphics": false,
      "_comment": "Not used when mode=standalone"
    },
    "spm": {
      "path": "/data/local/software/cat-12/external/spm12",
      "_comment": "Not used when mode=standalone"
    },
    "cat12_standalone": {
      "path": "/data/local/software/cat-12/external/cat12",
      "mcr_root": "/data/local/software/cat-12/external/MCR/v232/R2023b",
      "_comment": "Used when mode=standalone"
    },
    "python": {
      "executable": "python3",
      "venv": "/data/local/software/cat-12/.venv"
    }
  },
  "paths": {
    "_comment": "All paths are relative to study.project_folder",
    "bids_raw": "bids_data",
    "preproc_dir": "derivatives/cat12",
    "stats_dir": "results",
    "logs_dir": "logs"
  },
  "preprocessing": {
    "description": "CAT12 longitudinal preprocessing with surface extraction and smoothing",
    "enabled": true,
    "preflight_checks": {
      "check_environment": false,
      "check_disk_space": true,
      "check_dependencies": false,
      "min_disk_space_gb": 50,
      "_comment": "Disabled MATLAB/SPM checks for standalone mode"
    },
    "bids": {
      "source": "OpenNeuro ds004937",
      "bids_dir": "bids_data",
      "_bids_comment": "Will be downloaded to openneuro_dir",
      "analysis_level": "participant",
      "participant_label": [
        "119BPAF161001",
        "119BPAF161002",
        "119BPAF161003"
      ],
      "session_label": ["1", "2", "3"],
      "openneuro": true,
      "openneuro_dataset": "ds004937",
      "openneuro_download": true,
      "openneuro_download_all": false,
      "openneuro_download_only_anat": true,
      "openneuro_tag": null,
      "openneuro_dir": "/data/local/software/cat-12/openneuro/ds004937",
      "_download_comment": "Auto-download from OpenNeuro using AWS S3"
    },
    "processing": {
      "preproc": true,
      "no_surface": true,
      "qa": true,
      "tiv": true,
      "roi": false
    },
    "smoothing": {
      "smooth_volume": [6],
      "smooth_surface": []
    },
    "execution": {
      "output_dir": "derivatives/cat12",
      "work_dir": "work",
      "log_dir": "logs/preproc",
      "n_jobs": "auto",
      "skip_existing": true,
      "cross": false,
      "pilot": false
    },
    "validation": {
      "no_validate": true,
      "dry_run": false,
      "_dry_run_comment": "Set to true to validate without actually processing"
    }
  },
  "analysis": {
    "participants_file": "projects/demo/participants_ds004937.tsv",
    "group_column": "group",
    "session_column": "session",
    "sessions": ["1", "2", "3", "4"],
    "standardize_continuous": true,
    "_comment": "Define modalities below; each can have different smoothing, covariates, masks",
    "modalities": [
      {
        "name": "vbm",
        "folder_name": "vbm_smooth6",
        "smoothing_kernel": 6,
        "covariates": [],
        "mask": "templates/brainmask_GMtight.nii"
      }
    ]
  },
  "screening": {
    "uncorrected_p": 0.001,
    "cluster_size_voxels": 10,
    "skip_screening": false
  },
  "tfce": {
    "n_permutations": 100,
    "pilot_mode": false
  },
  "reporting": {
    "thresholds": [
      {"p_value": 0.01, "label": "Significant (p < 0.01)"},
      {"p_value": 0.05, "label": "Significant (p < 0.05)"},
      {"p_value": 0.1, "label": "Trend (p < 0.1)"}
    ]
  },
  "performance": {
    "parallel_jobs": 1,
    "memory_limit_gb": 16
  },
  "output": {
    "analysis_name": "ds004937_demo",
    "force_clean": false
  }
}
